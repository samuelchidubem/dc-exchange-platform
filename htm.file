<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="DC EXCHANGE: trade crypto, stocks, gold and index funds with live prices and a flat 0.5% fee.">
<title>DC EXCHANGE | Invest in crypto, stocks and gold</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;800&display=swap" rel="stylesheet">
<style>
:root{--bg:#f5f7fa;--pn:#fff;--ink:#101828;--mu:#667085;--ln:#e4e7ec;--br:#3347e0;--up:#0e9f6e;--dn:#e0443a}
[data-t=dark]{--bg:#0b1220;--pn:#121b2d;--ink:#e6eaf2;--mu:#8b98b1;--ln:#22304a;--br:#5b70ff}
*{box-sizing:border-box;margin:0}
body{font:15px/1.55 Manrope,system-ui,sans-serif;background:var(--bg);color:var(--ink)}
button,input,select{font:inherit;color:inherit}
.w{max-width:1120px;margin:auto;padding:0 20px}
header{position:sticky;top:0;z-index:20;background:var(--pn);border-bottom:1px solid var(--ln)}
.nav{display:flex;align-items:center;gap:20px;height:64px}
.logo{display:flex;align-items:center;gap:8px;font-weight:800;letter-spacing:.5px;color:var(--ink);text-decoration:none;cursor:pointer}
.logo i{background:var(--br);color:#fff;border-radius:9px;padding:4px 7px;font-style:normal}
#nv{display:flex;gap:4px;flex:1}
#nv button{background:none;border:0;padding:8px 12px;border-radius:8px;cursor:pointer;color:var(--mu);font-weight:600}
#nv button.on,#nv button:hover{color:var(--ink);background:var(--bg)}
#acct{display:flex;gap:8px;align-items:center}
.chip{background:var(--bg);border:1px solid var(--ln);padding:6px 12px;border-radius:20px;font-weight:600}
.b{padding:10px 16px;border-radius:10px;border:1px solid var(--ln);background:var(--pn);cursor:pointer;font-weight:600}
.b:hover{border-color:var(--br)}
.b.p{background:var(--br);border-color:var(--br);color:#fff}
.b.sl{background:var(--dn);border-color:var(--dn);color:#fff}
.b.sm{padding:5px 12px;font-size:13px}
.w100{width:100%}
:focus-visible{outline:2px solid var(--br);outline-offset:2px}
#bg{display:none}
.tkw{overflow:hidden;background:var(--ink);color:var(--bg);font-size:13px;white-space:nowrap}
#tk{display:inline-block;animation:mq 60s linear infinite}
#tk:hover{animation-play-state:paused}
#tk span{margin-right:32px;display:inline-block;padding:6px 0}
@keyframes mq{to{transform:translateX(-50%)}}
@media(prefers-reduced-motion:reduce){#tk{animation:none}}
.up{color:var(--up)}.dn{color:var(--dn)}
.mu{color:var(--mu)}small{color:var(--mu)}
.hero{display:grid;grid-template-columns:1.1fr .9fr;gap:40px;padding:56px 0;align-items:center}
h1{font-size:46px;line-height:1.1;font-weight:800;letter-spacing:-1px;margin-bottom:16px}
h2{font-size:26px;font-weight:800;margin-bottom:16px;letter-spacing:-.4px}
.hero p{color:var(--mu);font-size:17px;max-width:480px;margin-bottom:24px}
.row{display:flex;gap:10px;flex-wrap:wrap}
.perks{margin-top:24px;color:var(--mu);font-size:14px;display:flex;gap:18px;flex-wrap:wrap}
.card,.panel{background:var(--pn);border:1px solid var(--ln);border-radius:16px;padding:20px}
.tabs{display:flex;gap:6px;margin-bottom:14px;flex-wrap:wrap}
.tabs button,.seg button{border:1px solid var(--ln);background:var(--pn);border-radius:20px;padding:5px 14px;cursor:pointer;font-weight:600}
.tabs button.on,.seg button.on{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.big{font-size:32px;font-weight:800;letter-spacing:-.5px}
canvas{width:100%;height:220px;display:block;margin-top:10px}
.sec{padding:36px 0}
.g4{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.g3{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
button.card{text-align:left;cursor:pointer;display:flex;flex-direction:column;gap:2px;color:var(--ink)}
button.card:hover{border-color:var(--br)}
table{width:100%;border-collapse:collapse}
th,td{padding:12px 10px;text-align:left;border-bottom:1px solid var(--ln);white-space:nowrap}
th{color:var(--mu);font-weight:600;font-size:13px}
th button{background:none;border:0;cursor:pointer;color:inherit;font-weight:600}
.tw{overflow-x:auto}
.st{background:none;border:0;font-size:18px;cursor:pointer;color:var(--ln)}
.st.on{color:#f5a524}
.bar{display:flex;gap:10px;margin-bottom:14px;flex-wrap:wrap}
input,select{padding:10px 12px;border:1px solid var(--ln);border-radius:10px;background:var(--pn);width:100%}
.bar input{max-width:280px}
label{display:block;font-weight:600;font-size:13px;margin-bottom:12px}
label input,label select{margin-top:5px;font-weight:400}
.trade{display:grid;grid-template-columns:1.4fr 1fr;gap:20px;padding:32px 0}
.seg{display:flex;gap:6px;margin-bottom:16px}.seg button{flex:1;border-radius:10px}
#sm div{display:flex;justify-content:space-between;padding:6px 0;border-bottom:1px dashed var(--ln)}
#sm{margin:14px 0}
.chips{display:flex;gap:6px;margin-bottom:12px;flex-wrap:wrap}.chips .b{padding:5px 12px;font-size:13px}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin:28px 0}
.stats b{display:block;font-size:22px}
.act{display:flex;gap:8px;margin:0 0 20px}
details{background:var(--pn);border:1px solid var(--ln);border-radius:12px;padding:14px 18px;margin-bottom:8px}
summary{cursor:pointer;font-weight:600}details p{margin-top:8px;color:var(--mu)}
.calc{display:grid;grid-template-columns:1fr 1fr;gap:24px}
.calc .f{display:grid;grid-template-columns:1fr 1fr;gap:0 12px}
footer{border-top:1px solid var(--ln);margin-top:40px;padding:28px 0;color:var(--mu);font-size:13px}
#mo{position:fixed;inset:0;background:#0009;display:grid;place-items:center;z-index:50;padding:16px}
#mo[hidden]{display:none}
.box{background:var(--pn);border-radius:16px;padding:24px;width:100%;max-width:400px;position:relative}
.box h3{margin-bottom:14px}
.x{position:absolute;top:10px;right:14px;background:none;border:0;font-size:24px;cursor:pointer}
#ts{max-width:100%}
#toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);z-index:60;display:grid;gap:8px}
#toast div{background:var(--ink);color:var(--bg);padding:10px 18px;border-radius:10px;font-weight:600}
#toast .e{background:var(--dn);color:#fff}#toast .s{background:var(--up);color:#fff}
[hidden]{display:none!important}
@media(max-width:820px){
.hero,.trade,.calc{grid-template-columns:1fr}.g4,.stats{grid-template-columns:1fr 1fr}.g3{grid-template-columns:1fr}
h1{font-size:34px}#bg{display:block}
#nv{display:none;position:absolute;top:64px;left:0;right:0;background:var(--pn);flex-direction:column;padding:10px 20px;border-bottom:1px solid var(--ln)}
#nv.open{display:flex}.nav{gap:10px}.nav #acct{margin-left:auto}.chip{display:none}}

/* ===== Premium layer ===== */
:root{--navy:#0a1128;--br:#4f63ff;--sh:0 1px 2px rgba(16,24,40,.04),0 14px 34px -10px rgba(16,24,40,.14)}
body{overflow-x:hidden;-webkit-font-smoothing:antialiased}
header{background:rgba(10,17,40,.82);backdrop-filter:blur(16px);border-bottom:1px solid rgba(255,255,255,.08)}
.logo{color:#fff}
.logo i{background:linear-gradient(135deg,#6a7bff,#3347e0);box-shadow:0 4px 14px #4f63ff66}
#nv button{color:#9fb0d6}
#nv button.on,#nv button:hover{color:#fff;background:rgba(255,255,255,.08)}
header .b,header .chip{background:rgba(255,255,255,.07);color:#fff;border-color:rgba(255,255,255,.16)}
.b{border-radius:12px;transition:transform .15s,box-shadow .15s,border-color .15s}
.b:hover{transform:translateY(-1px)}
.b.p{background:linear-gradient(135deg,#6174ff,#3347e0);border-color:transparent;box-shadow:0 8px 20px -6px #4f63ffaa}
.b.sl{box-shadow:0 8px 20px -6px #e0443aaa}
.tkw{background:#060b1d;color:#b8c4e4;border-bottom:1px solid rgba(255,255,255,.06)}
.card,.panel,details,.box{box-shadow:var(--sh);border-radius:20px}
h2{font-size:30px}
.sec{padding:56px 0}
input:focus,select:focus{outline:2px solid var(--br);border-color:transparent}
tbody tr:hover td{background:var(--bg)}
.fu{animation:flu 1s}.fd{animation:fld 1s}
@keyframes flu{from{background:#0e9f6e44}to{background:transparent}}
@keyframes fld{from{background:#e0443a44}to{background:transparent}}
.ic{display:inline-grid;place-items:center;width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,hsl(var(--h) 80% 60%),hsl(var(--h) 70% 42%));color:#fff;font:800 11px/1 Manrope,sans-serif;font-style:normal;margin-right:10px;vertical-align:middle}
.card>.ic{margin:0 0 10px}
/* hero */
.hero{position:relative;z-index:0;padding:88px 0 96px}
.hero::before{content:"";position:absolute;inset:0 -50vw;background:url(data:image/svg+xml;base64,) center/cover,#0a1128;z-index:-1}
.hero h1{color:#fff;font-size:56px}
.hero p{color:#aab6d8}
.hero .perks{color:#8fa0cc}
.hero .card{background:rgba(255,255,255,.06);border-color:rgba(255,255,255,.14);color:#fff;backdrop-filter:blur(18px);box-shadow:0 30px 60px -20px #000a}
.hero .card small{color:#9fb0d6}
.hero .tabs button{background:transparent;color:#cfd8f3;border-color:rgba(255,255,255,.18)}
.hero .tabs button.on{background:#fff;color:#0a1128}
.hero .b:not(.p){background:rgba(255,255,255,.08);color:#fff;border-color:rgba(255,255,255,.2)}
.hero>div:first-child>*{animation:rise .7s both}
.hero>div:first-child>:nth-child(2){animation-delay:.1s}.hero>div:first-child>:nth-child(3){animation-delay:.2s}.hero>div:first-child>:nth-child(4){animation-delay:.3s}
@keyframes rise{from{opacity:0;transform:translateY(18px)}}
@media(prefers-reduced-motion:reduce){.hero>div:first-child>*{animation:none}}
/* sections */
.sb{text-align:center}.sb b{display:block;font-size:38px;font-weight:800;letter-spacing:-1px}.sb span{color:var(--mu)}
.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;counter-reset:s}
.steps .card{position:relative;padding-top:60px}
.steps .card::before{counter-increment:s;content:counter(s);position:absolute;top:20px;left:20px;width:30px;height:30px;border-radius:50%;background:var(--br);color:#fff;display:grid;place-items:center;font-weight:800}
.sec2{display:grid;grid-template-columns:.8fr 1.2fr;gap:48px;align-items:center}
.sec2 img{width:100%;max-width:320px;border-radius:32px;box-shadow:var(--sh)}
.sec2 li{margin:12px 0 0 18px}
.av{width:40px;height:40px;border-radius:50%;background:var(--br);color:#fff;display:grid;place-items:center;font-weight:800;margin-bottom:12px}
.cta{border-radius:28px;padding:64px 32px;text-align:center;color:#fff;background:url(data:image/svg+xml;base64,) center/cover,#0a1128}
.cta h2{font-size:34px}.cta p{color:#aab6d8;margin-bottom:22px}
footer{background:var(--navy);color:#8fa0cc;margin-top:56px;border:0;padding:48px 0 28px}
.fg{display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr;gap:30px}
footer .logo{color:#fff}footer h4{color:#fff;margin-bottom:10px}
footer a{display:block;color:#8fa0cc;cursor:pointer;margin:7px 0}footer a:hover{color:#fff}
.legal{border-top:1px solid #ffffff14;margin-top:32px;padding-top:18px;font-size:12px}
#ck{position:fixed;left:16px;bottom:16px;max-width:360px;z-index:55;background:var(--pn);border:1px solid var(--ln);border-radius:16px;padding:16px;box-shadow:var(--sh)}
#ck p{margin-bottom:10px;font-size:14px}
.rv{margin-bottom:16px}.rv div{display:flex;justify-content:space-between;padding:9px 0;border-bottom:1px dashed var(--ln)}
.alloc{display:flex;gap:28px;align-items:center;margin-bottom:28px}
#dn{width:180px;height:180px;margin:0}#lg div{margin:7px 0}
#lg i{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:8px}
@media(max-width:820px){
.steps,.sec2,.fg{grid-template-columns:1fr}.hero{padding:48px 0 56px}.hero h1{font-size:38px}
#nv{background:var(--navy)}.alloc{flex-direction:column;align-items:flex-start}.sec{padding:36px 0}}

/* ===== Support, chat, admin ===== */
textarea{width:100%;padding:10px 12px;border:1px solid var(--ln);border-radius:10px;background:var(--pn);min-height:120px;resize:vertical;margin-top:5px;font-weight:400}
a.lk{color:var(--br);font-weight:600}
.ag{text-align:center}.ag .av{width:72px;height:72px;font-size:22px;margin:0 auto 12px}.ag .row{justify-content:center;margin-top:16px}
#cb{position:fixed;right:20px;bottom:20px;z-index:55;width:56px;height:56px;border-radius:50%;border:0;background:linear-gradient(135deg,#6174ff,#3347e0);color:#fff;cursor:pointer;box-shadow:0 10px 24px -6px #4f63ffaa;display:grid;place-items:center}
#cb svg{width:26px;height:26px}
#cw{position:fixed;right:20px;bottom:90px;z-index:55;width:340px;max-width:calc(100vw - 40px);background:var(--pn);border:1px solid var(--ln);border-radius:20px;box-shadow:0 24px 60px -16px #000a;overflow:hidden}
.ch{display:flex;align-items:center;gap:8px;padding:14px 16px;background:var(--navy);color:#fff}.ch small{color:#8fa0cc;flex:1}.ch button{background:none;border:0;color:#fff;font-size:22px;cursor:pointer}
#cm{height:240px;overflow-y:auto;padding:14px;display:flex;flex-direction:column;gap:8px}
#cm div{max-width:85%;padding:9px 12px;border-radius:14px;font-size:14px}
#cm .bot{background:var(--bg);align-self:flex-start}#cm .me{background:var(--br);color:#fff;align-self:flex-end}
#cq{padding:0 14px 10px}#cf{display:flex;gap:8px;padding:12px;border-top:1px solid var(--ln)}
</style>
</head>
<body>
<header><div class="w nav">
<a class="logo" onclick="go('home')"><i>DC</i>EXCHANGE</a>
<nav id="nv">
<button data-v="home" onclick="go('home')">Home</button>
<button data-v="markets" onclick="go('markets')">Markets</button>
<button data-v="trade" onclick="go('trade')">Trade</button>
<button data-v="portfolio" onclick="go('portfolio')">Portfolio</button>
<button data-v="support" onclick="go('support')">Support</button>
<button data-v="admin" id="na" hidden onclick="go('admin')">Admin</button>
</nav>
<div id="acct"></div>
<button class="b sm" id="th" onclick="theme()" aria-label="Toggle dark mode">◐</button>
<button class="b sm" id="bg" onclick="$('#nv').classList.toggle('open')" aria-label="Menu">☰</button>
</div></header>
<div class="tkw"><div id="tk"></div></div>

<main class="w">
<section class="view" id="v-home">
<div class="hero">
<div>
<h1>Invest in the world’s markets from one account</h1>
<p>Buy and sell crypto, stocks, gold and index funds with a flat 0.5% fee, live prices and no hidden charges.</p>
<div class="row"><button class="b p" onclick="U()?go('trade'):auth('signup')">Get started</button><button class="b" onclick="go('markets')">Explore markets</button></div>
<div class="perks"><span>10 live markets</span><span>Flat 0.5% fee</span><span>Trade any time</span></div>
</div>
<div class="card">
<div class="tabs" id="ht"><button data-s="BTC" onclick="hs='BTC';renderHome()">BTC</button><button data-s="ETH" onclick="hs='ETH';renderHome()">ETH</button><button data-s="NVDA" onclick="hs='NVDA';renderHome()">NVDA</button><button data-s="XAU" onclick="hs='XAU';renderHome()">Gold</button></div>
<small id="hn"></small>
<div class="big" id="hp"></div><b id="hc"></b>
<canvas id="hch"></canvas>
<button class="b p w100" style="margin-top:12px" onclick="pick(hs,'buy')">Trade now</button>
</div>
</div>
<div class="sec"><h2>Biggest movers right now</h2><div class="g4" id="mv"></div></div>
<div class="sec"><h2>Why investors choose DC EXCHANGE</h2><div class="g3">
<div class="card"><b>Simple, flat pricing</b><p class="mu">One 0.5% fee on each trade. No deposit charges and no monthly costs.</p></div>
<div class="card"><b>Everything in one place</b><p class="mu">Hold crypto, shares, commodities and funds in a single portfolio.</p></div>
<div class="card"><b>Track your performance</b><p class="mu">See profit and loss per asset, with a full history of every transaction.</p></div></div></div>
<div class="sec"><div class="g4 sb"><div><b>$2.4B</b><span>Traded this year</span></div><div><b>180K+</b><span>Active investors</span></div><div><b>99.98%</b><span>Platform uptime</span></div><div><b>0.5%</b><span>Flat trading fee</span></div></div></div>
<div class="sec"><h2>Start investing in three steps</h2><div class="steps">
<div class="card"><b>Create your account</b><p class="mu">Sign up with your email in under a minute.</p></div>
<div class="card"><b>Fund your wallet</b><p class="mu">Deposit by bank transfer, card or USDT.</p></div>
<div class="card"><b>Place your first trade</b><p class="mu">Choose an asset, review the order and confirm.</p></div></div></div>
<div class="sec sec2"><img src="data:image/svg+xml;base64," alt="Security shield"><div><h2>Security you can rely on</h2><p class="mu">Your account and funds are protected by layered safeguards.</p><ul><li>Two-factor authentication for every login</li><li>Most assets held in offline cold storage</li><li>Encrypted data and 24/7 monitoring</li></ul></div></div>
<div class="sec"><h2>Trusted by investors worldwide</h2><div class="g3">
<div class="card"><div class="av">AO</div><p>“Clean, fast and easy to read. I made my first trade in minutes.”</p><small>Amara O., Lagos</small></div>
<div class="card"><div class="av">DK</div><p>“The flat fee means no surprises, and the portfolio view is excellent.”</p><small>Daniel K., London</small></div>
<div class="card"><div class="av">SM</div><p>“I track crypto and stocks side by side now. Nothing else does this well.”</p><small>Sofia M., Madrid</small></div></div></div>
<div class="sec"><h2>Growth calculator</h2><div class="card calc">
<div class="f"><label>Starting amount ($)<input id="c1" type="number" value="1000" min="0" oninput="calc()"></label>
<label>Monthly addition ($)<input id="c2" type="number" value="100" min="0" oninput="calc()"></label>
<label>Yearly return (%)<input id="c3" type="number" value="8" min="0" max="100" step="0.5" oninput="calc()"></label>
<label>Years<input id="c4" type="number" value="10" min="1" max="50" oninput="calc()"></label></div>
<div><small>Estimated value</small><div class="big" id="cr"></div><p class="mu" id="cd"></p><p class="mu" style="font-size:13px;margin-top:10px">An estimate only. Real returns vary and you can lose money.</p></div></div></div>
<div class="sec"><h2>Frequently asked questions</h2>
<details><summary>How do I start investing?</summary><p>Create a free account, deposit funds, then open the Trade page to buy your first asset.</p></details>
<details><summary>What does it cost?</summary><p>A flat 0.5% fee on every buy and sell. Deposits and withdrawals are free.</p></details>
<details><summary>Is this real money?</summary><p>No. This is a demo platform with simulated prices. Accounts and balances are saved only in your browser.</p></details>
<details><summary>Can I withdraw at any time?</summary><p>Yes. Open Portfolio and choose Withdraw to move available cash out.</p></details>
<details><summary>How do I contact support?</summary><p>Use the live chat, the <a class="lk" href="#" onclick="go('support');return false">contact form</a>, or email <a class="lk" href="mailto:samuelchidubem7777@gmail.com">samuelchidubem7777@gmail.com</a>.</p></details>
</div>
<div class="sec"><div class="cta"><h2>Ready to grow your portfolio?</h2><p>Open a free account and start trading today.</p><button class="b p" onclick="U()?go('trade'):auth('signup')">Create free account</button></div></div>
<div class="sec"><div class="card row" style="justify-content:space-between;align-items:center"><div><b>Get market updates</b><p class="mu">One email a week. Unsubscribe any time.</p></div>
<form class="row" onsubmit="event.preventDefault();toast('You are subscribed.','s');this.reset()"><input type="email" placeholder="you@email.com" required style="width:240px"><button class="b p">Subscribe</button></form></div></div>
</section>

<section class="view sec" id="v-markets" hidden>
<h2>Markets</h2>
<div class="bar"><input id="q" type="search" placeholder="Search assets" oninput="mk.q=this.value;renderMarkets()" aria-label="Search">
<div class="tabs" id="ft" style="margin:0"></div></div>
<div class="panel tw"><table><thead><tr><th></th><th><button onclick="srt('n')">Asset</button></th><th><button onclick="srt('p')">Price</button></th><th><button onclick="srt('c')">24h change</button></th><th></th></tr></thead><tbody id="mt"></tbody></table></div>
</section>

<section class="view" id="v-trade" hidden>
<div class="trade">
<div class="panel"><label style="max-width:260px">Asset<select id="ts" onchange="tr.s=this.value;renderTrade()"></select></label>
<small id="tn"></small><div class="big" id="tp"></div><b id="tc"></b><canvas id="tch" style="height:300px"></canvas></div>
<form class="panel" onsubmit="order(event)">
<div class="seg" id="sd"><button type="button" data-s="buy" onclick="tr.side='buy';renderTrade()">Buy</button><button type="button" data-s="sell" onclick="tr.side='sell';renderTrade()">Sell</button></div>
<label>Amount (USD)<input id="am" type="number" min="10" step="0.01" placeholder="0.00" oninput="sum()"></label>
<div class="chips"><button type="button" class="b" onclick="pct(25)">25%</button><button type="button" class="b" onclick="pct(50)">50%</button><button type="button" class="b" onclick="pct(75)">75%</button><button type="button" class="b" onclick="pct(100)">Max</button></div>
<small id="av"></small><div id="sm"></div>
<button class="b w100" id="go"></button>
</form></div>
</section>

<section class="view sec" id="v-portfolio" hidden>
<h2>Portfolio</h2>
<div class="act"><button class="b p" onclick="cash('dep')">Deposit</button><button class="b" onclick="cash('wd')">Withdraw</button></div>
<div class="stats" id="ps"></div>
<div class="panel alloc"><canvas id="dn"></canvas><div><h2 style="font-size:20px">Allocation</h2><div id="lg"></div></div></div>
<h2 style="font-size:20px">Holdings</h2>
<div class="panel tw" style="margin-bottom:28px"><table><thead><tr><th>Asset</th><th>Quantity</th><th>Avg cost</th><th>Value</th><th>Profit / loss</th><th></th></tr></thead><tbody id="ph"></tbody></table></div>
<div class="row" style="justify-content:space-between;align-items:center;margin-bottom:12px"><h2 style="font-size:20px;margin:0">Transactions</h2><button class="b sm" onclick="exportCsv()">Export CSV</button></div>
<div class="panel tw"><table><thead><tr><th>Date</th><th>Type</th><th>Details</th><th>Amount</th></tr></thead><tbody id="px"></tbody></table></div>
</section>
<section class="view sec" id="v-support" hidden>
<h2>Contact support</h2>
<div class="trade">
<form class="panel" onsubmit="sup(event)">
<label>Full name<input id="sn" required></label>
<label>Your email<input id="se" type="email" required></label>
<label>Topic<select id="st"><option>Account</option><option>Deposits</option><option>Trading</option><option>Withdrawals</option><option>Other</option></select></label>
<label>Message<textarea id="sg" required placeholder="How can we help?"></textarea></label>
<button class="b p w100">Send message</button>
</form>
<div class="panel ag"><div class="av">SC</div><b>Samuel Chidubem</b><p class="mu">Support agent</p>
<a class="lk" href="mailto:samuelchidubem7777@gmail.com">samuelchidubem7777@gmail.com</a>
<p class="mu" style="font-size:13px;margin-top:8px">Replies within 24 hours, Monday to Friday.</p>
<div class="row"><button class="b" onclick="copyMail()">Copy email</button><button class="b p" onclick="chat()">Start live chat</button></div></div>
</div></section>
<section class="view sec" id="v-admin" hidden><h2>Admin dashboard</h2><div class="stats" id="as"></div>
<div class="panel tw"><table><thead><tr><th>User</th><th>Cash</th><th>Holdings</th><th>Transactions</th><th>Actions</th></tr></thead><tbody id="ad"></tbody></table></div>
<p class="mu" style="margin-top:12px;font-size:13px">Shows accounts stored in this browser only.</p></section>
</main>

<footer><div class="w"><div class="fg"><div><a class="logo" onclick="go('home')"><i>DC</i>EXCHANGE</a><p style="margin-top:12px;max-width:280px">Invest in crypto, stocks, gold and funds from one account.</p><a href="mailto:samuelchidubem7777@gmail.com">samuelchidubem7777@gmail.com</a></div>
<div><h4>Platform</h4><a onclick="go('markets')">Markets</a><a onclick="go('trade')">Trade</a><a onclick="go('portfolio')">Portfolio</a></div>
<div><h4>Company</h4><a onclick="toast('This page is not part of the demo.')">About us</a><a onclick="toast('This page is not part of the demo.')">Careers</a><a onclick="go('support')">Contact</a></div>
<div><h4>Legal</h4><a onclick="toast('This page is not part of the demo.')">Terms of use</a><a onclick="toast('This page is not part of the demo.')">Privacy policy</a><a onclick="toast('This page is not part of the demo.')">Risk disclosure</a></div></div>
<p class="legal">© 2026 DC EXCHANGE. Demo platform with simulated prices and no real money. Investing carries risk and you can lose what you put in.</p></div></footer>
<div id="ck" hidden><p>We use cookies to remember your settings and improve the site.</p><div class="row"><button class="b p sm" onclick="ck('1')">Accept</button><button class="b sm" onclick="ck('0')">Decline</button></div></div>
<button id="cb" onclick="chat()" aria-label="Open support chat"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-11.6 7.1L3 21l1.9-5.4A8 8 0 1 1 21 12z"/></svg></button>
<div id="cw" hidden><div class="ch"><b>DC Support</b><small>Online</small><button onclick="chat()" aria-label="Close chat">×</button></div><div id="cm"></div><div class="chips" id="cq"></div><form id="cf" onsubmit="csend(event)"><input id="ci" placeholder="Type your message" autocomplete="off" aria-label="Message"><button class="b p sm">Send</button></form></div>
<div id="mo" hidden onclick="if(event.target==this)closeModal()"><div id="md"></div></div>
<div id="toast"></div>

<script>
const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];
const $f=n=>n.toLocaleString('en-US',{style:'currency',currency:'USD'});
const UP='#0e9f6e',DN='#e0443a';
const A=[['BTC','Bitcoin','Crypto',67420],['ETH','Ethereum','Crypto',3480],['SOL','Solana','Crypto',172],['AAPL','Apple','Stocks',228],['TSLA','Tesla','Stocks',251],['NVDA','Nvidia','Stocks',138],['MSFT','Microsoft','Stocks',421],['XAU','Gold','Commodities',2650],['OIL','Crude oil','Commodities',74.2],['SPY','S&P 500 ETF','Funds',585]].map(([s,n,t,p])=>{const a={s,n,t,p,h:[]};let v=p;for(let i=0;i<60;i++){a.h.unshift(v);v*=1+(Math.random()-.5)*.01}a.o=a.h[0];return a});
const ic=a=>`<i class="ic" style="--h:${A.indexOf(a)*37+210}">${a.s.slice(0,2)}</i>`;
const MAIL='samuelchidubem7777@gmail.com',esc=s=>s.replace(/[&<>"']/g,c=>'&#'+c.charCodeAt(0)+';'),isAdm=()=>db.cur==MAIL;
const F=a=>A.find(x=>x.s==a),chg=a=>(a.p/a.o-1)*100,pc=n=>(n>=0?'+':'')+n.toFixed(2)+'%',cl=n=>n>=0?'up':'dn';
let db={users:{},cur:null};try{db=JSON.parse(localStorage.getItem('dcx'))||db}catch(e){}
const save=()=>{try{localStorage.setItem('dcx',JSON.stringify(db))}catch(e){}};
const U=()=>db.users[db.cur];
let cur='home',hs='BTC',mk={q:'',f:'All',k:'n',d:1},tr={s:'BTC',side:'buy'};

function toast(m,t){const d=document.createElement('div');d.textContent=m;d.className=t||'';$('#toast').append(d);setTimeout(()=>d.remove(),3200)}
function modal(h){$('#md').innerHTML='<div class="box"><button class="x" onclick="closeModal()" aria-label="Close">×</button>'+h+'</div>';$('#mo').hidden=false;const i=$('#md input');i&&i.focus()}
function closeModal(){$('#mo').hidden=true}
addEventListener('keydown',e=>e.key=='Escape'&&closeModal());
function theme(){const d=document.documentElement,n=d.dataset.t=='dark'?'light':'dark';d.dataset.t=n;try{localStorage.setItem('dct',n)}catch(e){}}

function draw(c,d,col){const x=c.getContext('2d'),r=devicePixelRatio||1,w=c.clientWidth,h=c.clientHeight;if(!w)return;c.width=w*r;c.height=h*r;x.scale(r,r);const mn=Math.min(...d),sp=(Math.max(...d)-mn)||1;x.beginPath();d.forEach((v,i)=>{const X=i/(d.length-1)*w,Y=h-8-(v-mn)/sp*(h-16);i?x.lineTo(X,Y):x.moveTo(X,Y)});x.strokeStyle=col;x.lineWidth=2;x.stroke();x.lineTo(w,h);x.lineTo(0,h);const g=x.createLinearGradient(0,0,0,h);g.addColorStop(0,col+'33');g.addColorStop(1,col+'00');x.fillStyle=g;x.fill()}

function go(v){if(v=='portfolio'&&!U())return auth('login');if(v=='admin'&&!isAdm())return;cur=v;$$('.view').forEach(e=>e.hidden=e.id!='v-'+v);$$('#nv button').forEach(b=>b.classList.toggle('on',b.dataset.v==v));$('#nv').classList.remove('open');scrollTo(0,0);live()}
function pick(s,side){tr.s=s;tr.side=side;$('#am').value='';go('trade')}
function live(){ticker();({support:()=>{},admin:renderAdmin,home:renderHome,markets:renderMarkets,trade:renderTrade,portfolio:()=>{renderPort();donut()}})[cur]()}
function ticker(){const t=A.map(a=>`<span>${a.s} <b>${$f(a.p)}</b> <em class="${cl(chg(a))}">${pc(chg(a))}</em></span>`).join('');$('#tk').innerHTML=t+t}
function renderAcct(){const u=U();$('#na').hidden=!isAdm();$('#acct').innerHTML=u?`<span class="chip">${$f(u.cash)}</span><button class="b sm" onclick="go('portfolio')">${u.name.split(' ')[0]}</button><button class="b sm" onclick="out()">Log out</button>`:`<button class="b" onclick="auth('login')">Log in</button><button class="b p" onclick="auth('signup')">Sign up</button>`}

function renderHome(){const a=F(hs),c=chg(a);$('#hn').textContent=a.n+' · '+a.s;$('#hp').textContent=$f(a.p);$('#hc').textContent=pc(c);$('#hc').className=cl(c);$$('#ht button').forEach(b=>b.classList.toggle('on',b.dataset.s==hs));draw($('#hch'),a.h,c>=0?UP:DN);
$('#mv').innerHTML=[...A].sort((x,y)=>Math.abs(chg(y))-Math.abs(chg(x))).slice(0,4).map(a=>`<button class="card" onclick="pick('${a.s}','buy')">${ic(a)}<b>${a.n}</b><small>${a.s}</small><strong>${$f(a.p)}</strong><em class="${cl(chg(a))}">${pc(chg(a))}</em></button>`).join('')}

function srt(k){mk.d=mk.k==k?-mk.d:1;mk.k=k;renderMarkets()}
function star(s){const u=U();if(!u)return auth('login');const i=u.watch.indexOf(s);i<0?u.watch.push(s):u.watch.splice(i,1);save();renderMarkets()}
function renderMarkets(){const u=U(),w=u?u.watch:[];$('#ft').innerHTML=['All','Crypto','Stocks','Commodities','Funds','Watchlist'].map(f=>`<button class="${mk.f==f?'on':''}" onclick="mk.f='${f}';renderMarkets()">${f}</button>`).join('');
const r=A.filter(a=>(mk.f=='All'||(mk.f=='Watchlist'?w.includes(a.s):a.t==mk.f))&&(a.n+a.s).toLowerCase().includes(mk.q.toLowerCase())).sort((x,y)=>(mk.k=='n'?x.n.localeCompare(y.n):mk.k=='p'?x.p-y.p:chg(x)-chg(y))*mk.d);
$('#mt').innerHTML=r.map(a=>`<tr><td><button class="st ${w.includes(a.s)?'on':''}" onclick="star('${a.s}')" aria-label="Toggle watchlist">★</button></td><td>${ic(a)}<b>${a.n}</b> <small>${a.s}</small></td><td class="${a.d>0?'fu':a.d<0?'fd':''}">${$f(a.p)}</td><td class="${cl(chg(a))}">${pc(chg(a))}</td><td><button class="b p sm" onclick="pick('${a.s}','buy')">Trade</button></td></tr>`).join('')||'<tr><td colspan="5" class="mu">No assets found.</td></tr>'}

function renderTrade(){const a=F(tr.s),c=chg(a),u=U(),h=u&&u.hold[a.s];$('#ts').value=tr.s;$('#tn').textContent=a.n;$('#tp').textContent=$f(a.p);$('#tc').textContent=pc(c);$('#tc').className=cl(c);draw($('#tch'),a.h,c>=0?UP:DN);
$$('#sd button').forEach(b=>b.classList.toggle('on',b.dataset.s==tr.side));$('#go').textContent=(tr.side=='buy'?'Buy ':'Sell ')+a.s;$('#go').className='b w100 '+(tr.side=='buy'?'p':'sl');
$('#av').textContent=u?(tr.side=='buy'?'Available: '+$f(u.cash):'You hold: '+(h?h.q.toFixed(6):'0')+' '+a.s):'Log in to place orders';sum()}
function sum(){const a=F(tr.s),m=+$('#am').value||0,f=m*.005;$('#sm').innerHTML=`<div><span>Price</span><b>${$f(a.p)}</b></div><div><span>Quantity</span><b>${(m/a.p).toFixed(6)} ${a.s}</b></div><div><span>Fee (0.5%)</span><b>${$f(f)}</b></div><div><span>${tr.side=='buy'?'Total cost':'You receive'}</span><b>${$f(tr.side=='buy'?m+f:m-f)}</b></div>`}
function pct(p){const u=U();if(!u)return auth('login');const a=F(tr.s),mx=tr.side=='buy'?u.cash/1.005:(u.hold[a.s]?u.hold[a.s].q*a.p:0);$('#am').value=(Math.floor(mx*p)/100).toFixed(2);sum()}
function order(e){e.preventDefault();const u=U();if(!u)return auth('login');const a=F(tr.s),m=+$('#am').value,f=m*.005,b=tr.side=='buy';
if(!(m>=10))return toast('Minimum order is $10.','e');
if(b&&u.cash<m+f)return toast('Not enough cash. Deposit funds first.','e');
const h=u.hold[a.s];if(!b&&(!h||h.q*a.p<m-.01))return toast('You do not hold enough '+a.s+'.','e');
modal(`<h3>Review your order</h3><div class="rv"><div><span>Order</span><b>${b?'Buy':'Sell'} ${a.n}</b></div><div><span>Quantity</span><b>${(m/a.p).toFixed(6)} ${a.s}</b></div><div><span>Price</span><b>${$f(a.p)}</b></div><div><span>Fee (0.5%)</span><b>${$f(f)}</b></div><div><span>${b?'Total cost':'You receive'}</span><b>${$f(b?m+f:m-f)}</b></div></div><button class="b w100 ${b?'p':'sl'}" onclick="exec(${m},${a.p})">Confirm ${b?'purchase':'sale'}</button>`)}
function exec(m,p){const u=U(),a=F(tr.s),f=m*.005,b=tr.side=='buy';
if(b){if(u.cash<m+f)return toast('Not enough cash.','e');u.cash-=m+f;const h=u.hold[a.s]||(u.hold[a.s]={q:0,c:0});h.q+=m/p;h.c+=m}
else{const h=u.hold[a.s];if(!h||h.q*p<m-.01)return toast('Not enough '+a.s+'.','e');const q=Math.min(h.q,m/p);h.c*=1-q/h.q;h.q-=q;u.cash+=m-f;if(h.q<1e-9)delete u.hold[a.s]}
u.tx.unshift({t:Date.now(),k:tr.side,s:a.s,m,p});save();$('#am').value='';
modal(`<h3>${b?'Purchase':'Sale'} complete</h3><p class="mu" style="margin-bottom:16px">You ${b?'bought':'sold'} ${(m/p).toFixed(6)} ${a.s} at ${$f(p)}.</p><div class="row"><button class="b p" onclick="closeModal();go('portfolio')">View portfolio</button><button class="b" onclick="closeModal()">Done</button></div>`);renderAcct();renderTrade()}

function renderPort(){const u=U();if(!u)return go('home');let inv=0,cost=0;
const rows=Object.entries(u.hold).map(([s,h])=>{const a=F(s),v=h.q*a.p,pl=v-h.c;inv+=v;cost+=h.c;return `<tr><td>${ic(a)}<b>${a.n}</b> <small>${s}</small></td><td>${h.q.toFixed(6)}</td><td>${$f(h.c/h.q)}</td><td>${$f(v)}</td><td class="${cl(pl)}">${$f(pl)} (${pc(pl/h.c*100)})</td><td><button class="b sm" onclick="pick('${s}','sell')">Sell</button></td></tr>`});
$('#ps').innerHTML=[['Total balance',$f(u.cash+inv),''],['Cash',$f(u.cash),''],['Invested',$f(inv),''],['Profit / loss',$f(inv-cost),cl(inv-cost)]].map(([l,v,c])=>`<div class="card"><small>${l}</small><b class="${c}">${v}</b></div>`).join('');
$('#ph').innerHTML=rows.join('')||'<tr><td colspan="6" class="mu">No holdings yet. <a href="#" onclick="go(\'markets\');return false" style="color:var(--br)">Explore markets</a></td></tr>';
const L={buy:'Buy',sell:'Sell',dep:'Deposit',wd:'Withdrawal'};
$('#px').innerHTML=u.tx.slice(0,15).map(t=>`<tr><td>${new Date(t.t).toLocaleString()}</td><td>${L[t.k]}</td><td>${t.k=='buy'||t.k=='sell'?t.s+' at '+$f(t.p):t.s}</td><td>${$f(t.m)}</td></tr>`).join('')||'<tr><td colspan="4" class="mu">No transactions yet.</td></tr>'}

function cash(k){const d=k=='dep';modal(`<h3>${d?'Deposit':'Withdraw'} funds</h3><form onsubmit="cashGo(event,'${k}')"><label>Amount (USD)<input id="ca" type="number" min="10" step="0.01" required></label><div class="chips">${[100,500,1000,5000].map(n=>`<button type="button" class="b" onclick="$('#ca').value=${n}">$${n}</button>`).join('')}</div><label>Method<select id="cm"><option>Bank transfer</option><option>Debit card</option><option>USDT (TRC20)</option></select></label><button class="b p w100">Confirm ${d?'deposit':'withdrawal'}</button></form>`)}
function cashGo(e,k){e.preventDefault();const u=U(),m=+$('#ca').value;if(!(m>=10))return toast('Minimum is $10.','e');if(k=='wd'&&m>u.cash)return toast('Amount is more than your available cash.','e');u.cash+=k=='dep'?m:-m;u.tx.unshift({t:Date.now(),k,s:$('#cm').value,m});save();closeModal();toast(k=='dep'?'Deposit successful.':'Withdrawal requested.','s');renderAcct();renderPort()}

function auth(m){modal(`<div class="seg"><button class="${m=='login'?'on':''}" onclick="auth('login')">Log in</button><button class="${m=='signup'?'on':''}" onclick="auth('signup')">Sign up</button></div><form onsubmit="authGo(event,'${m}')">${m=='signup'?'<label>Full name<input id="an" required></label>':''}<label>Email<input id="ae" type="email" required></label><label>Password<input id="ap" type="password" minlength="6" required></label><button class="b p w100">${m=='login'?'Log in':'Create account'}</button></form><p class="mu" style="font-size:12px;margin-top:12px">Demo platform: accounts are stored in this browser only.</p>`)}
function authGo(e,m){e.preventDefault();const k=$('#ae').value.trim().toLowerCase(),p=$('#ap').value;
if(m=='signup'){if(db.users[k])return toast('An account with this email already exists.','e');db.users[k]={name:esc($('#an').value.trim()),pass:p,cash:0,hold:{},tx:[],watch:[]}}
else if(!db.users[k]||db.users[k].pass!=p)return toast('Incorrect email or password.','e');
db.cur=k;save();closeModal();renderAcct();toast(m=='signup'?'Welcome to DC EXCHANGE.':'Welcome back.','s');go(cur=='home'?'portfolio':cur)}
function out(){db.cur=null;save();renderAcct();go('home');toast('You are logged out.')}

function calc(){const P=+$('#c1').value||0,M=+$('#c2').value||0,r=(+$('#c3').value||0)/1200,n=(+$('#c4').value||1)*12,g=Math.pow(1+r,n),fv=P*g+M*(r?(g-1)/r:n),ct=P+M*n;$('#cr').textContent=$f(fv);$('#cd').textContent='You add '+$f(ct)+' and it grows by '+$f(fv-ct)+'.'}

$('#ts').innerHTML=A.map(a=>`<option value="${a.s}">${a.n} (${a.s})</option>`).join('');
try{document.documentElement.dataset.t=localStorage.getItem('dct')||''}catch(e){}
if(db.cur&&!U())db.cur=null;
renderAcct();calc();go('home');
setInterval(()=>{A.forEach(a=>{const o=a.p;a.p=Math.max(.01,a.p*(1+(Math.random()-.5)*(a.t=='Crypto'?.006:.003)));a.d=a.p>=o?1:-1;a.h.push(a.p);a.h.shift()});live()},2000);
addEventListener('resize',live);

function donut(){const u=U(),c=$('#dn');if(!u||!c||!c.clientWidth)return;const a=[['Cash',u.cash],...Object.entries(u.hold).map(([s,h])=>[s,h.q*F(s).p])].filter(x=>x[1]>0),T=a.reduce((s,x)=>s+x[1],0),x=c.getContext('2d'),r=devicePixelRatio||1,P=['#5b70ff','#0e9f6e','#f5a524','#e0443a','#22b8cf','#a855f7','#ec4899','#94a3b8'];c.width=c.height=180*r;x.scale(r,r);
if(!T){x.beginPath();x.arc(90,90,70,0,7);x.lineWidth=22;x.strokeStyle='#8884';x.stroke();$('#lg').innerHTML='<span class="mu">Deposit funds to see your allocation.</span>';return}
let s=-Math.PI/2;a.forEach(([k,v],i)=>{const e=v/T*Math.PI*2;x.beginPath();x.arc(90,90,70,s,s+e);x.lineWidth=22;x.strokeStyle=P[i%8];x.stroke();s+=e});
$('#lg').innerHTML=a.map(([k,v],i)=>`<div><i style="background:${P[i%8]}"></i>${k} <b>${(v/T*100).toFixed(1)}%</b></div>`).join('')}
function exportCsv(){const u=U();if(!u||!u.tx.length)return toast('No transactions to export.','e');const r=[['Date','Type','Asset or method','Price','Amount']].concat(u.tx.map(t=>[new Date(t.t).toISOString(),t.k,t.s,t.p||'',t.m.toFixed(2)]));const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([r.map(x=>x.join(',')).join('\n')],{type:'text/csv'}));a.download='dc-exchange-transactions.csv';a.click()}
function ck(v){try{localStorage.setItem('dck',v)}catch(e){}$('#ck').hidden=true}
try{if(!localStorage.getItem('dck'))$('#ck').hidden=false}catch(e){}

function sup(e){e.preventDefault();const g=i=>$(i).value.trim();location.href='mailto:'+MAIL+'?subject='+encodeURIComponent('['+g('#st')+'] Support request from '+g('#sn'))+'&body='+encodeURIComponent(g('#sg')+'\n\nFrom: '+g('#sn')+' ('+g('#se')+')');toast('Opening your email app to send the message.','s')}
function copyMail(){(navigator.clipboard?navigator.clipboard.writeText(MAIL):Promise.reject()).then(()=>toast('Email copied.','s')).catch(()=>toast(MAIL))}
const QA=[['deposit','Open Portfolio, choose Deposit, enter an amount and pick a method.'],['withdraw','Open Portfolio and choose Withdraw. Enter an amount up to your available cash.'],['fee','We charge a flat 0.5% on every buy and sell. Deposits and withdrawals are free.'],['safe','Accounts are protected by layered security. This demo uses simulated money only.'],['password','Use the Log in box and check your email and password. This demo stores accounts in your browser only.']];
function cmsg(t,me){const d=document.createElement('div');d.className=me?'me':'bot';me?d.textContent=t:d.innerHTML=t;$('#cm').append(d);$('#cm').scrollTop=1e5}
function chat(){const w=$('#cw');w.hidden=!w.hidden;if(!w.hidden&&!$('#cm').children.length){cmsg('Hi, I am the DC EXCHANGE support assistant. How can I help?');$('#cq').innerHTML=['How do I deposit?','What are the fees?','Is my money safe?','Talk to a person'].map(q=>`<button type="button" class="b sm" onclick="cask('${q}')">${q}</button>`).join('')}}
function cask(q){cmsg(q,1);setTimeout(()=>cmsg(reply(q)),500)}
function reply(q){q=q.toLowerCase();const m=`<a class="lk" href="mailto:${MAIL}">${MAIL}</a>`;if(/person|agent|human/.test(q))return `Our support agent can help. Email ${m} or use the <a class="lk" href="#" onclick="chat();go('support');return false">contact form</a>.`;const f=QA.find(x=>q.includes(x[0]));return f?f[1]:`I am not sure about that. Please email ${m} and our agent will reply within 24 hours.`}
function csend(e){e.preventDefault();const i=$('#ci'),v=i.value.trim();if(v){i.value='';cask(v)}}
function renderAdmin(){if(!isAdm())return go('home');const us=Object.entries(db.users);
$('#as').innerHTML=[['Users',us.length],['Total cash',$f(us.reduce((s,[k,u])=>s+u.cash,0))],['Transactions',us.reduce((s,[k,u])=>s+u.tx.length,0)]].map(([l,v])=>`<div class="card"><small>${l}</small><b>${v}</b></div>`).join('');
$('#ad').innerHTML=us.map(([k,u])=>`<tr><td><b>${esc(u.name)}</b><br><small>${esc(k)}</small></td><td>${$f(u.cash)}</td><td>${Object.keys(u.hold).length}</td><td>${u.tx.length}</td><td><div class="row"><button class="b sm" onclick="adj('${k}',1)">Credit</button><button class="b sm" onclick="adj('${k}',-1)">Debit</button>${k==MAIL?'':`<button class="b sm" onclick="del('${k}')">Delete</button>`}</div></td></tr>`).join('')}
function adj(k,s){modal(`<h3>${s>0?'Credit':'Debit'} ${esc(db.users[k].name)}</h3><form onsubmit="adjGo(event,'${k}',${s})"><label>Amount (USD)<input id="aa" type="number" min="1" step="0.01" required></label><button class="b p w100">Apply</button></form>`)}
function adjGo(e,k,s){e.preventDefault();const u=db.users[k],m=+$('#aa').value;if(s<0&&m>u.cash)return toast('Amount is more than the balance.','e');u.cash+=s*m;u.tx.unshift({t:Date.now(),k:s>0?'dep':'wd',s:'Admin adjustment',m});save();closeModal();toast('Balance updated.','s');renderAdmin();renderAcct()}
function del(k){if(confirm('Delete this account?')){delete db.users[k];save();renderAdmin();toast('Account deleted.')}}
</script>
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="DC EXCHANGE: trade crypto, stocks, gold and index funds with live prices and a flat 0.5% fee.">
<title>DC EXCHANGE | Invest in crypto, stocks and gold</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;800&display=swap" rel="stylesheet">
<style>
:root{--bg:#f5f7fa;--pn:#fff;--ink:#101828;--mu:#667085;--ln:#e4e7ec;--br:#3347e0;--up:#0e9f6e;--dn:#e0443a}
[data-t=dark]{--bg:#0b1220;--pn:#121b2d;--ink:#e6eaf2;--mu:#8b98b1;--ln:#22304a;--br:#5b70ff}
*{box-sizing:border-box;margin:0}
body{font:15px/1.55 Manrope,system-ui,sans-serif;background:var(--bg);color:var(--ink)}
button,input,select{font:inherit;color:inherit}
.w{max-width:1120px;margin:auto;padding:0 20px}
header{position:sticky;top:0;z-index:20;background:var(--pn);border-bottom:1px solid var(--ln)}
.nav{display:flex;align-items:center;gap:20px;height:64px}
.logo{display:flex;align-items:center;gap:8px;font-weight:800;letter-spacing:.5px;color:var(--ink);text-decoration:none;cursor:pointer}
.logo i{background:var(--br);color:#fff;border-radius:9px;padding:4px 7px;font-style:normal}
#nv{display:flex;gap:4px;flex:1}
#nv button{background:none;border:0;padding:8px 12px;border-radius:8px;cursor:pointer;color:var(--mu);font-weight:600}
#nv button.on,#nv button:hover{color:var(--ink);background:var(--bg)}
#acct{display:flex;gap:8px;align-items:center}
.chip{background:var(--bg);border:1px solid var(--ln);padding:6px 12px;border-radius:20px;font-weight:600}
.b{padding:10px 16px;border-radius:10px;border:1px solid var(--ln);background:var(--pn);cursor:pointer;font-weight:600}
.b:hover{border-color:var(--br)}
.b.p{background:var(--br);border-color:var(--br);color:#fff}
.b.sl{background:var(--dn);border-color:var(--dn);color:#fff}
.b.sm{padding:5px 12px;font-size:13px}
.w100{width:100%}
:focus-visible{outline:2px solid var(--br);outline-offset:2px}
#bg{display:none}
.tkw{overflow:hidden;background:var(--ink);color:var(--bg);font-size:13px;white-space:nowrap}
#tk{display:inline-block;animation:mq 60s linear infinite}
#tk:hover{animation-play-state:paused}
#tk span{margin-right:32px;display:inline-block;padding:6px 0}
@keyframes mq{to{transform:translateX(-50%)}}
@media(prefers-reduced-motion:reduce){#tk{animation:none}}
.up{color:var(--up)}.dn{color:var(--dn)}
.mu{color:var(--mu)}small{color:var(--mu)}
.hero{display:grid;grid-template-columns:1.1fr .9fr;gap:40px;padding:56px 0;align-items:center}
h1{font-size:46px;line-height:1.1;font-weight:800;letter-spacing:-1px;margin-bottom:16px}
h2{font-size:26px;font-weight:800;margin-bottom:16px;letter-spacing:-.4px}
.hero p{color:var(--mu);font-size:17px;max-width:480px;margin-bottom:24px}
.row{display:flex;gap:10px;flex-wrap:wrap}
.perks{margin-top:24px;color:var(--mu);font-size:14px;display:flex;gap:18px;flex-wrap:wrap}
.card,.panel{background:var(--pn);border:1px solid var(--ln);border-radius:16px;padding:20px}
.tabs{display:flex;gap:6px;margin-bottom:14px;flex-wrap:wrap}
.tabs button,.seg button{border:1px solid var(--ln);background:var(--pn);border-radius:20px;padding:5px 14px;cursor:pointer;font-weight:600}
.tabs button.on,.seg button.on{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.big{font-size:32px;font-weight:800;letter-spacing:-.5px}
canvas{width:100%;height:220px;display:block;margin-top:10px}
.sec{padding:36px 0}
.g4{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.g3{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
button.card{text-align:left;cursor:pointer;display:flex;flex-direction:column;gap:2px;color:var(--ink)}
button.card:hover{border-color:var(--br)}
table{width:100%;border-collapse:collapse}
th,td{padding:12px 10px;text-align:left;border-bottom:1px solid var(--ln);white-space:nowrap}
th{color:var(--mu);font-weight:600;font-size:13px}
th button{background:none;border:0;cursor:pointer;color:inherit;font-weight:600}
.tw{overflow-x:auto}
.st{background:none;border:0;font-size:18px;cursor:pointer;color:var(--ln)}
.st.on{color:#f5a524}
.bar{display:flex;gap:10px;margin-bottom:14px;flex-wrap:wrap}
input,select{padding:10px 12px;border:1px solid var(--ln);border-radius:10px;background:var(--pn);width:100%}
.bar input{max-width:280px}
label{display:block;font-weight:600;font-size:13px;margin-bottom:12px}
label input,label select{margin-top:5px;font-weight:400}
.trade{display:grid;grid-template-columns:1.4fr 1fr;gap:20px;padding:32px 0}
.seg{display:flex;gap:6px;margin-bottom:16px}.seg button{flex:1;border-radius:10px}
#sm div{display:flex;justify-content:space-between;padding:6px 0;border-bottom:1px dashed var(--ln)}
#sm{margin:14px 0}
.chips{display:flex;gap:6px;margin-bottom:12px;flex-wrap:wrap}.chips .b{padding:5px 12px;font-size:13px}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin:28px 0}
.stats b{display:block;font-size:22px}
.act{display:flex;gap:8px;margin:0 0 20px}
details{background:var(--pn);border:1px solid var(--ln);border-radius:12px;padding:14px 18px;margin-bottom:8px}
summary{cursor:pointer;font-weight:600}details p{margin-top:8px;color:var(--mu)}
.calc{display:grid;grid-template-columns:1fr 1fr;gap:24px}
.calc .f{display:grid;grid-template-columns:1fr 1fr;gap:0 12px}
footer{border-top:1px solid var(--ln);margin-top:40px;padding:28px 0;color:var(--mu);font-size:13px}
#mo{position:fixed;inset:0;background:#0009;display:grid;place-items:center;z-index:50;padding:16px}
#mo[hidden]{display:none}
.box{background:var(--pn);border-radius:16px;padding:24px;width:100%;max-width:400px;position:relative}
.box h3{margin-bottom:14px}
.x{position:absolute;top:10px;right:14px;background:none;border:0;font-size:24px;cursor:pointer}
#ts{max-width:100%}
#toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);z-index:60;display:grid;gap:8px}
#toast div{background:var(--ink);color:var(--bg);padding:10px 18px;border-radius:10px;font-weight:600}
#toast .e{background:var(--dn);color:#fff}#toast .s{background:var(--up);color:#fff}
[hidden]{display:none!important}
@media(max-width:820px){
.hero,.trade,.calc{grid-template-columns:1fr}.g4,.stats{grid-template-columns:1fr 1fr}.g3{grid-template-columns:1fr}
h1{font-size:34px}#bg{display:block}
#nv{display:none;position:absolute;top:64px;left:0;right:0;background:var(--pn);flex-direction:column;padding:10px 20px;border-bottom:1px solid var(--ln)}
#nv.open{display:flex}.nav{gap:10px}.nav #acct{margin-left:auto}.chip{display:none}}

/* ===== Premium layer ===== */
:root{--navy:#0a1128;--br:#4f63ff;--sh:0 1px 2px rgba(16,24,40,.04),0 14px 34px -10px rgba(16,24,40,.14)}
body{overflow-x:hidden;-webkit-font-smoothing:antialiased}
header{background:rgba(10,17,40,.82);backdrop-filter:blur(16px);border-bottom:1px solid rgba(255,255,255,.08)}
.logo{color:#fff}
.logo i{background:linear-gradient(135deg,#6a7bff,#3347e0);box-shadow:0 4px 14px #4f63ff66}
#nv button{color:#9fb0d6}
#nv button.on,#nv button:hover{color:#fff;background:rgba(255,255,255,.08)}
header .b,header .chip{background:rgba(255,255,255,.07);color:#fff;border-color:rgba(255,255,255,.16)}
.b{border-radius:12px;transition:transform .15s,box-shadow .15s,border-color .15s}
.b:hover{transform:translateY(-1px)}
.b.p{background:linear-gradient(135deg,#6174ff,#3347e0);border-color:transparent;box-shadow:0 8px 20px -6px #4f63ffaa}
.b.sl{box-shadow:0 8px 20px -6px #e0443aaa}
.tkw{background:#060b1d;color:#b8c4e4;border-bottom:1px solid rgba(255,255,255,.06)}
.card,.panel,details,.box{box-shadow:var(--sh);border-radius:20px}
h2{font-size:30px}
.sec{padding:56px 0}
input:focus,select:focus{outline:2px solid var(--br);border-color:transparent}
tbody tr:hover td{background:var(--bg)}
.fu{animation:flu 1s}.fd{animation:fld 1s}
@keyframes flu{from{background:#0e9f6e44}to{background:transparent}}
@keyframes fld{from{background:#e0443a44}to{background:transparent}}
.ic{display:inline-grid;place-items:center;width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,hsl(var(--h) 80% 60%),hsl(var(--h) 70% 42%));color:#fff;font:800 11px/1 Manrope,sans-serif;font-style:normal;margin-right:10px;vertical-align:middle}
.card>.ic{margin:0 0 10px}
/* hero */
.hero{position:relative;z-index:0;padding:88px 0 96px}
.hero::before{content:"";position:absolute;inset:0 -50vw;background:url(data:image/svg+xml;base64,) center/cover,#0a1128;z-index:-1}
.hero h1{color:#fff;font-size:56px}
.hero p{color:#aab6d8}
.hero .perks{color:#8fa0cc}
.hero .card{background:rgba(255,255,255,.06);border-color:rgba(255,255,255,.14);color:#fff;backdrop-filter:blur(18px);box-shadow:0 30px 60px -20px #000a}
.hero .card small{color:#9fb0d6}
.hero .tabs button{background:transparent;color:#cfd8f3;border-color:rgba(255,255,255,.18)}
.hero .tabs button.on{background:#fff;color:#0a1128}
.hero .b:not(.p){background:rgba(255,255,255,.08);color:#fff;border-color:rgba(255,255,255,.2)}
.hero>div:first-child>*{animation:rise .7s both}
.hero>div:first-child>:nth-child(2){animation-delay:.1s}.hero>div:first-child>:nth-child(3){animation-delay:.2s}.hero>div:first-child>:nth-child(4){animation-delay:.3s}
@keyframes rise{from{opacity:0;transform:translateY(18px)}}
@media(prefers-reduced-motion:reduce){.hero>div:first-child>*{animation:none}}
/* sections */
.sb{text-align:center}.sb b{display:block;font-size:38px;font-weight:800;letter-spacing:-1px}.sb span{color:var(--mu)}
.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;counter-reset:s}
.steps .card{position:relative;padding-top:60px}
.steps .card::before{counter-increment:s;content:counter(s);position:absolute;top:20px;left:20px;width:30px;height:30px;border-radius:50%;background:var(--br);color:#fff;display:grid;place-items:center;font-weight:800}
.sec2{display:grid;grid-template-columns:.8fr 1.2fr;gap:48px;align-items:center}
.sec2 img{width:100%;max-width:320px;border-radius:32px;box-shadow:var(--sh)}
.sec2 li{margin:12px 0 0 18px}
.av{width:40px;height:40px;border-radius:50%;background:var(--br);color:#fff;display:grid;place-items:center;font-weight:800;margin-bottom:12px}
.cta{border-radius:28px;padding:64px 32px;text-align:center;color:#fff;background:url(data:image/svg+xml;base64,) center/cover,#0a1128}
.cta h2{font-size:34px}.cta p{color:#aab6d8;margin-bottom:22px}
footer{background:var(--navy);color:#8fa0cc;margin-top:56px;border:0;padding:48px 0 28px}
.fg{display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr;gap:30px}
footer .logo{color:#fff}footer h4{color:#fff;margin-bottom:10px}
footer a{display:block;color:#8fa0cc;cursor:pointer;margin:7px 0}footer a:hover{color:#fff}
.legal{border-top:1px solid #ffffff14;margin-top:32px;padding-top:18px;font-size:12px}
#ck{position:fixed;left:16px;bottom:16px;max-width:360px;z-index:55;background:var(--pn);border:1px solid var(--ln);border-radius:16px;padding:16px;box-shadow:var(--sh)}
#ck p{margin-bottom:10px;font-size:14px}
.rv{margin-bottom:16px}.rv div{display:flex;justify-content:space-between;padding:9px 0;border-bottom:1px dashed var(--ln)}
.alloc{display:flex;gap:28px;align-items:center;margin-bottom:28px}
#dn{width:180px;height:180px;margin:0}#lg div{margin:7px 0}
#lg i{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:8px}
@media(max-width:820px){
.steps,.sec2,.fg{grid-template-columns:1fr}.hero{padding:48px 0 56px}.hero h1{font-size:38px}
#nv{background:var(--navy)}.alloc{flex-direction:column;align-items:flex-start}.sec{padding:36px 0}}

/* ===== Support, chat, admin ===== */
textarea{width:100%;padding:10px 12px;border:1px solid var(--ln);border-radius:10px;background:var(--pn);min-height:120px;resize:vertical;margin-top:5px;font-weight:400}
a.lk{color:var(--br);font-weight:600}
.ag{text-align:center}.ag .av{width:72px;height:72px;font-size:22px;margin:0 auto 12px}.ag .row{justify-content:center;margin-top:16px}
#cb{position:fixed;right:20px;bottom:20px;z-index:55;width:56px;height:56px;border-radius:50%;border:0;background:linear-gradient(135deg,#6174ff,#3347e0);color:#fff;cursor:pointer;box-shadow:0 10px 24px -6px #4f63ffaa;display:grid;place-items:center}
#cb svg{width:26px;height:26px}
#cw{position:fixed;right:20px;bottom:90px;z-index:55;width:340px;max-width:calc(100vw - 40px);background:var(--pn);border:1px solid var(--ln);border-radius:20px;box-shadow:0 24px 60px -16px #000a;overflow:hidden}
.ch{display:flex;align-items:center;gap:8px;padding:14px 16px;background:var(--navy);color:#fff}.ch small{color:#8fa0cc;flex:1}.ch button{background:none;border:0;color:#fff;font-size:22px;cursor:pointer}
#cm{height:240px;overflow-y:auto;padding:14px;display:flex;flex-direction:column;gap:8px}
#cm div{max-width:85%;padding:9px 12px;border-radius:14px;font-size:14px}
#cm .bot{background:var(--bg);align-self:flex-start}#cm .me{background:var(--br);color:#fff;align-self:flex-end}
#cq{padding:0 14px 10px}#cf{display:flex;gap:8px;padding:12px;border-top:1px solid var(--ln)}
</style>
</head>
<body>
<header><div class="w nav">
<a class="logo" onclick="go('home')"><i>DC</i>EXCHANGE</a>
<nav id="nv">
<button data-v="home" onclick="go('home')">Home</button>
<button data-v="markets" onclick="go('markets')">Markets</button>
<button data-v="trade" onclick="go('trade')">Trade</button>
<button data-v="portfolio" onclick="go('portfolio')">Portfolio</button>
<button data-v="support" onclick="go('support')">Support</button>
<button data-v="admin" id="na" hidden onclick="go('admin')">Admin</button>
</nav>
<div id="acct"></div>
<button class="b sm" id="th" onclick="theme()" aria-label="Toggle dark mode">◐</button>
<button class="b sm" id="bg" onclick="$('#nv').classList.toggle('open')" aria-label="Menu">☰</button>
</div></header>
<div class="tkw"><div id="tk"></div></div>

<main class="w">
<section class="view" id="v-home">
<div class="hero">
<div>
<h1>Invest in the world’s markets from one account</h1>
<p>Buy and sell crypto, stocks, gold and index funds with a flat 0.5% fee, live prices and no hidden charges.</p>
<div class="row"><button class="b p" onclick="U()?go('trade'):auth('signup')">Get started</button><button class="b" onclick="go('markets')">Explore markets</button></div>
<div class="perks"><span>10 live markets</span><span>Flat 0.5% fee</span><span>Trade any time</span></div>
</div>
<div class="card">
<div class="tabs" id="ht"><button data-s="BTC" onclick="hs='BTC';renderHome()">BTC</button><button data-s="ETH" onclick="hs='ETH';renderHome()">ETH</button><button data-s="NVDA" onclick="hs='NVDA';renderHome()">NVDA</button><button data-s="XAU" onclick="hs='XAU';renderHome()">Gold</button></div>
<small id="hn"></small>
<div class="big" id="hp"></div><b id="hc"></b>
<canvas id="hch"></canvas>
<button class="b p w100" style="margin-top:12px" onclick="pick(hs,'buy')">Trade now</button>
</div>
</div>
<div class="sec"><h2>Biggest movers right now</h2><div class="g4" id="mv"></div></div>
<div class="sec"><h2>Why investors choose DC EXCHANGE</h2><div class="g3">
<div class="card"><b>Simple, flat pricing</b><p class="mu">One 0.5% fee on each trade. No deposit charges and no monthly costs.</p></div>
<div class="card"><b>Everything in one place</b><p class="mu">Hold crypto, shares, commodities and funds in a single portfolio.</p></div>
<div class="card"><b>Track your performance</b><p class="mu">See profit and loss per asset, with a full history of every transaction.</p></div></div></div>
<div class="sec"><div class="g4 sb"><div><b>$2.4B</b><span>Traded this year</span></div><div><b>180K+</b><span>Active investors</span></div><div><b>99.98%</b><span>Platform uptime</span></div><div><b>0.5%</b><span>Flat trading fee</span></div></div></div>
<div class="sec"><h2>Start investing in three steps</h2><div class="steps">
<div class="card"><b>Create your account</b><p class="mu">Sign up with your email in under a minute.</p></div>
<div class="card"><b>Fund your wallet</b><p class="mu">Deposit by bank transfer, card or USDT.</p></div>
<div class="card"><b>Place your first trade</b><p class="mu">Choose an asset, review the order and confirm.</p></div></div></div>
<div class="sec sec2"><img src="data:image/svg+xml;base64," alt="Security shield"><div><h2>Security you can rely on</h2><p class="mu">Your account and funds are protected by layered safeguards.</p><ul><li>Two-factor authentication for every login</li><li>Most assets held in offline cold storage</li><li>Encrypted data and 24/7 monitoring</li></ul></div></div>
<div class="sec"><h2>Trusted by investors worldwide</h2><div class="g3">
<div class="card"><div class="av">AO</div><p>“Clean, fast and easy to read. I made my first trade in minutes.”</p><small>Amara O., Lagos</small></div>
<div class="card"><div class="av">DK</div><p>“The flat fee means no surprises, and the portfolio view is excellent.”</p><small>Daniel K., London</small></div>
<div class="card"><div class="av">SM</div><p>“I track crypto and stocks side by side now. Nothing else does this well.”</p><small>Sofia M., Madrid</small></div></div></div>
<div class="sec"><h2>Growth calculator</h2><div class="card calc">
<div class="f"><label>Starting amount ($)<input id="c1" type="number" value="1000" min="0" oninput="calc()"></label>
<label>Monthly addition ($)<input id="c2" type="number" value="100" min="0" oninput="calc()"></label>
<label>Yearly return (%)<input id="c3" type="number" value="8" min="0" max="100" step="0.5" oninput="calc()"></label>
<label>Years<input id="c4" type="number" value="10" min="1" max="50" oninput="calc()"></label></div>
<div><small>Estimated value</small><div class="big" id="cr"></div><p class="mu" id="cd"></p><p class="mu" style="font-size:13px;margin-top:10px">An estimate only. Real returns vary and you can lose money.</p></div></div></div>
<div class="sec"><h2>Frequently asked questions</h2>
<details><summary>How do I start investing?</summary><p>Create a free account, deposit funds, then open the Trade page to buy your first asset.</p></details>
<details><summary>What does it cost?</summary><p>A flat 0.5% fee on every buy and sell. Deposits and withdrawals are free.</p></details>
<details><summary>Is this real money?</summary><p>No. This is a demo platform with simulated prices. Accounts and balances are saved only in your browser.</p></details>
<details><summary>Can I withdraw at any time?</summary><p>Yes. Open Portfolio and choose Withdraw to move available cash out.</p></details>
<details><summary>How do I contact support?</summary><p>Use the live chat, the <a class="lk" href="#" onclick="go('support');return false">contact form</a>, or email <a class="lk" href="mailto:samuelchidubem7777@gmail.com">samuelchidubem7777@gmail.com</a>.</p></details>
</div>
<div class="sec"><div class="cta"><h2>Ready to grow your portfolio?</h2><p>Open a free account and start trading today.</p><button class="b p" onclick="U()?go('trade'):auth('signup')">Create free account</button></div></div>
<div class="sec"><div class="card row" style="justify-content:space-between;align-items:center"><div><b>Get market updates</b><p class="mu">One email a week. Unsubscribe any time.</p></div>
<form class="row" onsubmit="event.preventDefault();toast('You are subscribed.','s');this.reset()"><input type="email" placeholder="you@email.com" required style="width:240px"><button class="b p">Subscribe</button></form></div></div>
</section>

<section class="view sec" id="v-markets" hidden>
<h2>Markets</h2>
<div class="bar"><input id="q" type="search" placeholder="Search assets" oninput="mk.q=this.value;renderMarkets()" aria-label="Search">
<div class="tabs" id="ft" style="margin:0"></div></div>
<div class="panel tw"><table><thead><tr><th></th><th><button onclick="srt('n')">Asset</button></th><th><button onclick="srt('p')">Price</button></th><th><button onclick="srt('c')">24h change</button></th><th></th></tr></thead><tbody id="mt"></tbody></table></div>
</section>

<section class="view" id="v-trade" hidden>
<div class="trade">
<div class="panel"><label style="max-width:260px">Asset<select id="ts" onchange="tr.s=this.value;renderTrade()"></select></label>
<small id="tn"></small><div class="big" id="tp"></div><b id="tc"></b><canvas id="tch" style="height:300px"></canvas></div>
<form class="panel" onsubmit="order(event)">
<div class="seg" id="sd"><button type="button" data-s="buy" onclick="tr.side='buy';renderTrade()">Buy</button><button type="button" data-s="sell" onclick="tr.side='sell';renderTrade()">Sell</button></div>
<label>Amount (USD)<input id="am" type="number" min="10" step="0.01" placeholder="0.00" oninput="sum()"></label>
<div class="chips"><button type="button" class="b" onclick="pct(25)">25%</button><button type="button" class="b" onclick="pct(50)">50%</button><button type="button" class="b" onclick="pct(75)">75%</button><button type="button" class="b" onclick="pct(100)">Max</button></div>
<small id="av"></small><div id="sm"></div>
<button class="b w100" id="go"></button>
</form></div>
</section>

<section class="view sec" id="v-portfolio" hidden>
<h2>Portfolio</h2>
<div class="act"><button class="b p" onclick="cash('dep')">Deposit</button><button class="b" onclick="cash('wd')">Withdraw</button></div>
<div class="stats" id="ps"></div>
<div class="panel alloc"><canvas id="dn"></canvas><div><h2 style="font-size:20px">Allocation</h2><div id="lg"></div></div></div>
<h2 style="font-size:20px">Holdings</h2>
<div class="panel tw" style="margin-bottom:28px"><table><thead><tr><th>Asset</th><th>Quantity</th><th>Avg cost</th><th>Value</th><th>Profit / loss</th><th></th></tr></thead><tbody id="ph"></tbody></table></div>
<div class="row" style="justify-content:space-between;align-items:center;margin-bottom:12px"><h2 style="font-size:20px;margin:0">Transactions</h2><button class="b sm" onclick="exportCsv()">Export CSV</button></div>
<div class="panel tw"><table><thead><tr><th>Date</th><th>Type</th><th>Details</th><th>Amount</th></tr></thead><tbody id="px"></tbody></table></div>
</section>
<section class="view sec" id="v-support" hidden>
<h2>Contact support</h2>
<div class="trade">
<form class="panel" onsubmit="sup(event)">
<label>Full name<input id="sn" required></label>
<label>Your email<input id="se" type="email" required></label>
<label>Topic<select id="st"><option>Account</option><option>Deposits</option><option>Trading</option><option>Withdrawals</option><option>Other</option></select></label>
<label>Message<textarea id="sg" required placeholder="How can we help?"></textarea></label>
<button class="b p w100">Send message</button>
</form>
<div class="panel ag"><div class="av">SC</div><b>Samuel Chidubem</b><p class="mu">Support agent</p>
<a class="lk" href="mailto:samuelchidubem7777@gmail.com">samuelchidubem7777@gmail.com</a>
<p class="mu" style="font-size:13px;margin-top:8px">Replies within 24 hours, Monday to Friday.</p>
<div class="row"><button class="b" onclick="copyMail()">Copy email</button><button class="b p" onclick="chat()">Start live chat</button></div></div>
</div></section>
<section class="view sec" id="v-admin" hidden><h2>Admin dashboard</h2><div class="stats" id="as"></div>
<div class="panel tw"><table><thead><tr><th>User</th><th>Cash</th><th>Holdings</th><th>Transactions</th><th>Actions</th></tr></thead><tbody id="ad"></tbody></table></div>
<p class="mu" style="margin-top:12px;font-size:13px">Shows accounts stored in this browser only.</p></section>
</main>

<footer><div class="w"><div class="fg"><div><a class="logo" onclick="go('home')"><i>DC</i>EXCHANGE</a><p style="margin-top:12px;max-width:280px">Invest in crypto, stocks, gold and funds from one account.</p><a href="mailto:samuelchidubem7777@gmail.com">samuelchidubem7777@gmail.com</a></div>
<div><h4>Platform</h4><a onclick="go('markets')">Markets</a><a onclick="go('trade')">Trade</a><a onclick="go('portfolio')">Portfolio</a></div>
<div><h4>Company</h4><a onclick="toast('This page is not part of the demo.')">About us</a><a onclick="toast('This page is not part of the demo.')">Careers</a><a onclick="go('support')">Contact</a></div>
<div><h4>Legal</h4><a onclick="toast('This page is not part of the demo.')">Terms of use</a><a onclick="toast('This page is not part of the demo.')">Privacy policy</a><a onclick="toast('This page is not part of the demo.')">Risk disclosure</a></div></div>
<p class="legal">© 2026 DC EXCHANGE. Demo platform with simulated prices and no real money. Investing carries risk and you can lose what you put in.</p></div></footer>
<div id="ck" hidden><p>We use cookies to remember your settings and improve the site.</p><div class="row"><button class="b p sm" onclick="ck('1')">Accept</button><button class="b sm" onclick="ck('0')">Decline</button></div></div>
<button id="cb" onclick="chat()" aria-label="Open support chat"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-11.6 7.1L3 21l1.9-5.4A8 8 0 1 1 21 12z"/></svg></button>
<div id="cw" hidden><div class="ch"><b>DC Support</b><small>Online</small><button onclick="chat()" aria-label="Close chat">×</button></div><div id="cm"></div><div class="chips" id="cq"></div><form id="cf" onsubmit="csend(event)"><input id="ci" placeholder="Type your message" autocomplete="off" aria-label="Message"><button class="b p sm">Send</button></form></div>
<div id="mo" hidden onclick="if(event.target==this)closeModal()"><div id="md"></div></div>
<div id="toast"></div>

<script>
const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];
const $f=n=>n.toLocaleString('en-US',{style:'currency',currency:'USD'});
const UP='#0e9f6e',DN='#e0443a';
const A=[['BTC','Bitcoin','Crypto',67420],['ETH','Ethereum','Crypto',3480],['SOL','Solana','Crypto',172],['AAPL','Apple','Stocks',228],['TSLA','Tesla','Stocks',251],['NVDA','Nvidia','Stocks',138],['MSFT','Microsoft','Stocks',421],['XAU','Gold','Commodities',2650],['OIL','Crude oil','Commodities',74.2],['SPY','S&P 500 ETF','Funds',585]].map(([s,n,t,p])=>{const a={s,n,t,p,h:[]};let v=p;for(let i=0;i<60;i++){a.h.unshift(v);v*=1+(Math.random()-.5)*.01}a.o=a.h[0];return a});
const ic=a=>`<i class="ic" style="--h:${A.indexOf(a)*37+210}">${a.s.slice(0,2)}</i>`;
const MAIL='samuelchidubem7777@gmail.com',esc=s=>s.replace(/[&<>"']/g,c=>'&#'+c.charCodeAt(0)+';'),isAdm=()=>db.cur==MAIL;
const F=a=>A.find(x=>x.s==a),chg=a=>(a.p/a.o-1)*100,pc=n=>(n>=0?'+':'')+n.toFixed(2)+'%',cl=n=>n>=0?'up':'dn';
let db={users:{},cur:null};try{db=JSON.parse(localStorage.getItem('dcx'))||db}catch(e){}
const save=()=>{try{localStorage.setItem('dcx',JSON.stringify(db))}catch(e){}};
const U=()=>db.users[db.cur];
let cur='home',hs='BTC',mk={q:'',f:'All',k:'n',d:1},tr={s:'BTC',side:'buy'};

function toast(m,t){const d=document.createElement('div');d.textContent=m;d.className=t||'';$('#toast').append(d);setTimeout(()=>d.remove(),3200)}
function modal(h){$('#md').innerHTML='<div class="box"><button class="x" onclick="closeModal()" aria-label="Close">×</button>'+h+'</div>';$('#mo').hidden=false;const i=$('#md input');i&&i.focus()}
function closeModal(){$('#mo').hidden=true}
addEventListener('keydown',e=>e.key=='Escape'&&closeModal());
function theme(){const d=document.documentElement,n=d.dataset.t=='dark'?'light':'dark';d.dataset.t=n;try{localStorage.setItem('dct',n)}catch(e){}}

function draw(c,d,col){const x=c.getContext('2d'),r=devicePixelRatio||1,w=c.clientWidth,h=c.clientHeight;if(!w)return;c.width=w*r;c.height=h*r;x.scale(r,r);const mn=Math.min(...d),sp=(Math.max(...d)-mn)||1;x.beginPath();d.forEach((v,i)=>{const X=i/(d.length-1)*w,Y=h-8-(v-mn)/sp*(h-16);i?x.lineTo(X,Y):x.moveTo(X,Y)});x.strokeStyle=col;x.lineWidth=2;x.stroke();x.lineTo(w,h);x.lineTo(0,h);const g=x.createLinearGradient(0,0,0,h);g.addColorStop(0,col+'33');g.addColorStop(1,col+'00');x.fillStyle=g;x.fill()}

function go(v){if(v=='portfolio'&&!U())return auth('login');if(v=='admin'&&!isAdm())return;cur=v;$$('.view').forEach(e=>e.hidden=e.id!='v-'+v);$$('#nv button').forEach(b=>b.classList.toggle('on',b.dataset.v==v));$('#nv').classList.remove('open');scrollTo(0,0);live()}
function pick(s,side){tr.s=s;tr.side=side;$('#am').value='';go('trade')}
function live(){ticker();({support:()=>{},admin:renderAdmin,home:renderHome,markets:renderMarkets,trade:renderTrade,portfolio:()=>{renderPort();donut()}})[cur]()}
function ticker(){const t=A.map(a=>`<span>${a.s} <b>${$f(a.p)}</b> <em class="${cl(chg(a))}">${pc(chg(a))}</em></span>`).join('');$('#tk').innerHTML=t+t}
function renderAcct(){const u=U();$('#na').hidden=!isAdm();$('#acct').innerHTML=u?`<span class="chip">${$f(u.cash)}</span><button class="b sm" onclick="go('portfolio')">${u.name.split(' ')[0]}</button><button class="b sm" onclick="out()">Log out</button>`:`<button class="b" onclick="auth('login')">Log in</button><button class="b p" onclick="auth('signup')">Sign up</button>`}

function renderHome(){const a=F(hs),c=chg(a);$('#hn').textContent=a.n+' · '+a.s;$('#hp').textContent=$f(a.p);$('#hc').textContent=pc(c);$('#hc').className=cl(c);$$('#ht button').forEach(b=>b.classList.toggle('on',b.dataset.s==hs));draw($('#hch'),a.h,c>=0?UP:DN);
$('#mv').innerHTML=[...A].sort((x,y)=>Math.abs(chg(y))-Math.abs(chg(x))).slice(0,4).map(a=>`<button class="card" onclick="pick('${a.s}','buy')">${ic(a)}<b>${a.n}</b><small>${a.s}</small><strong>${$f(a.p)}</strong><em class="${cl(chg(a))}">${pc(chg(a))}</em></button>`).join('')}

function srt(k){mk.d=mk.k==k?-mk.d:1;mk.k=k;renderMarkets()}
function star(s){const u=U();if(!u)return auth('login');const i=u.watch.indexOf(s);i<0?u.watch.push(s):u.watch.splice(i,1);save();renderMarkets()}
function renderMarkets(){const u=U(),w=u?u.watch:[];$('#ft').innerHTML=['All','Crypto','Stocks','Commodities','Funds','Watchlist'].map(f=>`<button class="${mk.f==f?'on':''}" onclick="mk.f='${f}';renderMarkets()">${f}</button>`).join('');
const r=A.filter(a=>(mk.f=='All'||(mk.f=='Watchlist'?w.includes(a.s):a.t==mk.f))&&(a.n+a.s).toLowerCase().includes(mk.q.toLowerCase())).sort((x,y)=>(mk.k=='n'?x.n.localeCompare(y.n):mk.k=='p'?x.p-y.p:chg(x)-chg(y))*mk.d);
$('#mt').innerHTML=r.map(a=>`<tr><td><button class="st ${w.includes(a.s)?'on':''}" onclick="star('${a.s}')" aria-label="Toggle watchlist">★</button></td><td>${ic(a)}<b>${a.n}</b> <small>${a.s}</small></td><td class="${a.d>0?'fu':a.d<0?'fd':''}">${$f(a.p)}</td><td class="${cl(chg(a))}">${pc(chg(a))}</td><td><button class="b p sm" onclick="pick('${a.s}','buy')">Trade</button></td></tr>`).join('')||'<tr><td colspan="5" class="mu">No assets found.</td></tr>'}

function renderTrade(){const a=F(tr.s),c=chg(a),u=U(),h=u&&u.hold[a.s];$('#ts').value=tr.s;$('#tn').textContent=a.n;$('#tp').textContent=$f(a.p);$('#tc').textContent=pc(c);$('#tc').className=cl(c);draw($('#tch'),a.h,c>=0?UP:DN);
$$('#sd button').forEach(b=>b.classList.toggle('on',b.dataset.s==tr.side));$('#go').textContent=(tr.side=='buy'?'Buy ':'Sell ')+a.s;$('#go').className='b w100 '+(tr.side=='buy'?'p':'sl');
$('#av').textContent=u?(tr.side=='buy'?'Available: '+$f(u.cash):'You hold: '+(h?h.q.toFixed(6):'0')+' '+a.s):'Log in to place orders';sum()}
function sum(){const a=F(tr.s),m=+$('#am').value||0,f=m*.005;$('#sm').innerHTML=`<div><span>Price</span><b>${$f(a.p)}</b></div><div><span>Quantity</span><b>${(m/a.p).toFixed(6)} ${a.s}</b></div><div><span>Fee (0.5%)</span><b>${$f(f)}</b></div><div><span>${tr.side=='buy'?'Total cost':'You receive'}</span><b>${$f(tr.side=='buy'?m+f:m-f)}</b></div>`}
function pct(p){const u=U();if(!u)return auth('login');const a=F(tr.s),mx=tr.side=='buy'?u.cash/1.005:(u.hold[a.s]?u.hold[a.s].q*a.p:0);$('#am').value=(Math.floor(mx*p)/100).toFixed(2);sum()}
function order(e){e.preventDefault();const u=U();if(!u)return auth('login');const a=F(tr.s),m=+$('#am').value,f=m*.005,b=tr.side=='buy';
if(!(m>=10))return toast('Minimum order is $10.','e');
if(b&&u.cash<m+f)return toast('Not enough cash. Deposit funds first.','e');
const h=u.hold[a.s];if(!b&&(!h||h.q*a.p<m-.01))return toast('You do not hold enough '+a.s+'.','e');
modal(`<h3>Review your order</h3><div class="rv"><div><span>Order</span><b>${b?'Buy':'Sell'} ${a.n}</b></div><div><span>Quantity</span><b>${(m/a.p).toFixed(6)} ${a.s}</b></div><div><span>Price</span><b>${$f(a.p)}</b></div><div><span>Fee (0.5%)</span><b>${$f(f)}</b></div><div><span>${b?'Total cost':'You receive'}</span><b>${$f(b?m+f:m-f)}</b></div></div><button class="b w100 ${b?'p':'sl'}" onclick="exec(${m},${a.p})">Confirm ${b?'purchase':'sale'}</button>`)}
function exec(m,p){const u=U(),a=F(tr.s),f=m*.005,b=tr.side=='buy';
if(b){if(u.cash<m+f)return toast('Not enough cash.','e');u.cash-=m+f;const h=u.hold[a.s]||(u.hold[a.s]={q:0,c:0});h.q+=m/p;h.c+=m}
else{const h=u.hold[a.s];if(!h||h.q*p<m-.01)return toast('Not enough '+a.s+'.','e');const q=Math.min(h.q,m/p);h.c*=1-q/h.q;h.q-=q;u.cash+=m-f;if(h.q<1e-9)delete u.hold[a.s]}
u.tx.unshift({t:Date.now(),k:tr.side,s:a.s,m,p});save();$('#am').value='';
modal(`<h3>${b?'Purchase':'Sale'} complete</h3><p class="mu" style="margin-bottom:16px">You ${b?'bought':'sold'} ${(m/p).toFixed(6)} ${a.s} at ${$f(p)}.</p><div class="row"><button class="b p" onclick="closeModal();go('portfolio')">View portfolio</button><button class="b" onclick="closeModal()">Done</button></div>`);renderAcct();renderTrade()}

function renderPort(){const u=U();if(!u)return go('home');let inv=0,cost=0;
const rows=Object.entries(u.hold).map(([s,h])=>{const a=F(s),v=h.q*a.p,pl=v-h.c;inv+=v;cost+=h.c;return `<tr><td>${ic(a)}<b>${a.n}</b> <small>${s}</small></td><td>${h.q.toFixed(6)}</td><td>${$f(h.c/h.q)}</td><td>${$f(v)}</td><td class="${cl(pl)}">${$f(pl)} (${pc(pl/h.c*100)})</td><td><button class="b sm" onclick="pick('${s}','sell')">Sell</button></td></tr>`});
$('#ps').innerHTML=[['Total balance',$f(u.cash+inv),''],['Cash',$f(u.cash),''],['Invested',$f(inv),''],['Profit / loss',$f(inv-cost),cl(inv-cost)]].map(([l,v,c])=>`<div class="card"><small>${l}</small><b class="${c}">${v}</b></div>`).join('');
$('#ph').innerHTML=rows.join('')||'<tr><td colspan="6" class="mu">No holdings yet. <a href="#" onclick="go(\'markets\');return false" style="color:var(--br)">Explore markets</a></td></tr>';
const L={buy:'Buy',sell:'Sell',dep:'Deposit',wd:'Withdrawal'};
$('#px').innerHTML=u.tx.slice(0,15).map(t=>`<tr><td>${new Date(t.t).toLocaleString()}</td><td>${L[t.k]}</td><td>${t.k=='buy'||t.k=='sell'?t.s+' at '+$f(t.p):t.s}</td><td>${$f(t.m)}</td></tr>`).join('')||'<tr><td colspan="4" class="mu">No transactions yet.</td></tr>'}

function cash(k){const d=k=='dep';modal(`<h3>${d?'Deposit':'Withdraw'} funds</h3><form onsubmit="cashGo(event,'${k}')"><label>Amount (USD)<input id="ca" type="number" min="10" step="0.01" required></label><div class="chips">${[100,500,1000,5000].map(n=>`<button type="button" class="b" onclick="$('#ca').value=${n}">$${n}</button>`).join('')}</div><label>Method<select id="cm"><option>Bank transfer</option><option>Debit card</option><option>USDT (TRC20)</option></select></label><button class="b p w100">Confirm ${d?'deposit':'withdrawal'}</button></form>`)}
function cashGo(e,k){e.preventDefault();const u=U(),m=+$('#ca').value;if(!(m>=10))return toast('Minimum is $10.','e');if(k=='wd'&&m>u.cash)return toast('Amount is more than your available cash.','e');u.cash+=k=='dep'?m:-m;u.tx.unshift({t:Date.now(),k,s:$('#cm').value,m});save();closeModal();toast(k=='dep'?'Deposit successful.':'Withdrawal requested.','s');renderAcct();renderPort()}

function auth(m){modal(`<div class="seg"><button class="${m=='login'?'on':''}" onclick="auth('login')">Log in</button><button class="${m=='signup'?'on':''}" onclick="auth('signup')">Sign up</button></div><form onsubmit="authGo(event,'${m}')">${m=='signup'?'<label>Full name<input id="an" required></label>':''}<label>Email<input id="ae" type="email" required></label><label>Password<input id="ap" type="password" minlength="6" required></label><button class="b p w100">${m=='login'?'Log in':'Create account'}</button></form><p class="mu" style="font-size:12px;margin-top:12px">Demo platform: accounts are stored in this browser only.</p>`)}
function authGo(e,m){e.preventDefault();const k=$('#ae').value.trim().toLowerCase(),p=$('#ap').value;
if(m=='signup'){if(db.users[k])return toast('An account with this email already exists.','e');db.users[k]={name:esc($('#an').value.trim()),pass:p,cash:0,hold:{},tx:[],watch:[]}}
else if(!db.users[k]||db.users[k].pass!=p)return toast('Incorrect email or password.','e');
db.cur=k;save();closeModal();renderAcct();toast(m=='signup'?'Welcome to DC EXCHANGE.':'Welcome back.','s');go(cur=='home'?'portfolio':cur)}
function out(){db.cur=null;save();renderAcct();go('home');toast('You are logged out.')}

function calc(){const P=+$('#c1').value||0,M=+$('#c2').value||0,r=(+$('#c3').value||0)/1200,n=(+$('#c4').value||1)*12,g=Math.pow(1+r,n),fv=P*g+M*(r?(g-1)/r:n),ct=P+M*n;$('#cr').textContent=$f(fv);$('#cd').textContent='You add '+$f(ct)+' and it grows by '+$f(fv-ct)+'.'}

$('#ts').innerHTML=A.map(a=>`<option value="${a.s}">${a.n} (${a.s})</option>`).join('');
try{document.documentElement.dataset.t=localStorage.getItem('dct')||''}catch(e){}
if(db.cur&&!U())db.cur=null;
renderAcct();calc();go('home');
setInterval(()=>{A.forEach(a=>{const o=a.p;a.p=Math.max(.01,a.p*(1+(Math.random()-.5)*(a.t=='Crypto'?.006:.003)));a.d=a.p>=o?1:-1;a.h.push(a.p);a.h.shift()});live()},2000);
addEventListener('resize',live);

function donut(){const u=U(),c=$('#dn');if(!u||!c||!c.clientWidth)return;const a=[['Cash',u.cash],...Object.entries(u.hold).map(([s,h])=>[s,h.q*F(s).p])].filter(x=>x[1]>0),T=a.reduce((s,x)=>s+x[1],0),x=c.getContext('2d'),r=devicePixelRatio||1,P=['#5b70ff','#0e9f6e','#f5a524','#e0443a','#22b8cf','#a855f7','#ec4899','#94a3b8'];c.width=c.height=180*r;x.scale(r,r);
if(!T){x.beginPath();x.arc(90,90,70,0,7);x.lineWidth=22;x.strokeStyle='#8884';x.stroke();$('#lg').innerHTML='<span class="mu">Deposit funds to see your allocation.</span>';return}
let s=-Math.PI/2;a.forEach(([k,v],i)=>{const e=v/T*Math.PI*2;x.beginPath();x.arc(90,90,70,s,s+e);x.lineWidth=22;x.strokeStyle=P[i%8];x.stroke();s+=e});
$('#lg').innerHTML=a.map(([k,v],i)=>`<div><i style="background:${P[i%8]}"></i>${k} <b>${(v/T*100).toFixed(1)}%</b></div>`).join('')}
function exportCsv(){const u=U();if(!u||!u.tx.length)return toast('No transactions to export.','e');const r=[['Date','Type','Asset or method','Price','Amount']].concat(u.tx.map(t=>[new Date(t.t).toISOString(),t.k,t.s,t.p||'',t.m.toFixed(2)]));const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([r.map(x=>x.join(',')).join('\n')],{type:'text/csv'}));a.download='dc-exchange-transactions.csv';a.click()}
function ck(v){try{localStorage.setItem('dck',v)}catch(e){}$('#ck').hidden=true}
try{if(!localStorage.getItem('dck'))$('#ck').hidden=false}catch(e){}

function sup(e){e.preventDefault();const g=i=>$(i).value.trim();location.href='mailto:'+MAIL+'?subject='+encodeURIComponent('['+g('#st')+'] Support request from '+g('#sn'))+'&body='+encodeURIComponent(g('#sg')+'\n\nFrom: '+g('#sn')+' ('+g('#se')+')');toast('Opening your email app to send the message.','s')}
function copyMail(){(navigator.clipboard?navigator.clipboard.writeText(MAIL):Promise.reject()).then(()=>toast('Email copied.','s')).catch(()=>toast(MAIL))}
const QA=[['deposit','Open Portfolio, choose Deposit, enter an amount and pick a method.'],['withdraw','Open Portfolio and choose Withdraw. Enter an amount up to your available cash.'],['fee','We charge a flat 0.5% on every buy and sell. Deposits and withdrawals are free.'],['safe','Accounts are protected by layered security. This demo uses simulated money only.'],['password','Use the Log in box and check your email and password. This demo stores accounts in your browser only.']];
function cmsg(t,me){const d=document.createElement('div');d.className=me?'me':'bot';me?d.textContent=t:d.innerHTML=t;$('#cm').append(d);$('#cm').scrollTop=1e5}
function chat(){const w=$('#cw');w.hidden=!w.hidden;if(!w.hidden&&!$('#cm').children.length){cmsg('Hi, I am the DC EXCHANGE support assistant. How can I help?');$('#cq').innerHTML=['How do I deposit?','What are the fees?','Is my money safe?','Talk to a person'].map(q=>`<button type="button" class="b sm" onclick="cask('${q}')">${q}</button>`).join('')}}
function cask(q){cmsg(q,1);setTimeout(()=>cmsg(reply(q)),500)}
function reply(q){q=q.toLowerCase();const m=`<a class="lk" href="mailto:${MAIL}">${MAIL}</a>`;if(/person|agent|human/.test(q))return `Our support agent can help. Email ${m} or use the <a class="lk" href="#" onclick="chat();go('support');return false">contact form</a>.`;const f=QA.find(x=>q.includes(x[0]));return f?f[1]:`I am not sure about that. Please email ${m} and our agent will reply within 24 hours.`}
function csend(e){e.preventDefault();const i=$('#ci'),v=i.value.trim();if(v){i.value='';cask(v)}}
function renderAdmin(){if(!isAdm())return go('home');const us=Object.entries(db.users);
$('#as').innerHTML=[['Users',us.length],['Total cash',$f(us.reduce((s,[k,u])=>s+u.cash,0))],['Transactions',us.reduce((s,[k,u])=>s+u.tx.length,0)]].map(([l,v])=>`<div class="card"><small>${l}</small><b>${v}</b></div>`).join('');
$('#ad').innerHTML=us.map(([k,u])=>`<tr><td><b>${esc(u.name)}</b><br><small>${esc(k)}</small></td><td>${$f(u.cash)}</td><td>${Object.keys(u.hold).length}</td><td>${u.tx.length}</td><td><div class="row"><button class="b sm" onclick="adj('${k}',1)">Credit</button><button class="b sm" onclick="adj('${k}',-1)">Debit</button>${k==MAIL?'':`<button class="b sm" onclick="del('${k}')">Delete</button>`}</div></td></tr>`).join('')}
function adj(k,s){modal(`<h3>${s>0?'Credit':'Debit'} ${esc(db.users[k].name)}</h3><form onsubmit="adjGo(event,'${k}',${s})"><label>Amount (USD)<input id="aa" type="number" min="1" step="0.01" required></label><button class="b p w100">Apply</button></form>`)}
function adjGo(e,k,s){e.preventDefault();const u=db.users[k],m=+$('#aa').value;if(s<0&&m>u.cash)return toast('Amount is more than the balance.','e');u.cash+=s*m;u.tx.unshift({t:Date.now(),k:s>0?'dep':'wd',s:'Admin adjustment',m});save();closeModal();toast('Balance updated.','s');renderAdmin();renderAcct()}
function del(k){if(confirm('Delete this account?')){delete db.users[k];save();renderAdmin();toast('Account deleted.')}}
</script>
</body>
</html>
